# ==============================================================================
# Environment Variables Template for UniTrade / Uzmusika E-Commerce Platform
# Duplicate this file to '.env' and fill in your actual private credentials.
# NEVER commit the actual '.env' file or secret values to version control!
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-character-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database Settings (Leave empty or sqlite3 for local development)
DATABASE_URL=sqlite:///db.sqlite3
# For MySQL / PostgreSQL:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=e_commerce
# DB_USER=your_db_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=3306

# Email / SMTP Settings (For order notifications & password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password_here
DEFAULT_FROM_EMAIL=your_email@gmail.com
ADMIN_EMAIL=admin@example.com

# Stripe Payment Gateway (Optional for card processing)
STRIPE_PUBLIC_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Campus Payment Integrations (EcoCash, InnBucks, OneMoney, ZIPIT)
ECOCASH_MERCHANT_CODE=
INNBUCKS_ACCOUNT=
ONEMONEY_MERCHANT_CODE=
